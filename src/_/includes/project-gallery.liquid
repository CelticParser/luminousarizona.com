<section class="row mb-6">
  <section class="col">
    <h2>{{ title }} Gallery</h2>
    <div class="gallery gallery-two-column">
      {% assign currentTag = title | slugify %}
      {% comment %} Get all images that have this project tag in their tags (supports both string and array) {% endcomment %}
      {% assign galleryImages = "" | split: "," %}
      {% for image in collections.images %}
        {% assign imageTags = image.data.tags %}
        {% assign hasTag = false %}
        {% if imageTags %}
          {% if imageTags == currentTag %}
            {% assign hasTag = true %}
            {% elsif imageTags.first %}
            {% comment %} tags is an array {% endcomment %}
            {% for tag in imageTags %}
              {% if tag == currentTag %}
                {% assign hasTag = true %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}
        {% if hasTag %}
          {% assign galleryImages = galleryImages | push: image %}
        {% endif %}
      {% endfor %}
      {% for post in galleryImages %}
        <figure class="gallery-item">
          <div class="gallery-image">
            <a href="{{ post.url }}">
              {% assign galleryImgObjectPos = post.data.ImagePosition | default: post.data.tumbCardPosition | default: post.data.thumbCardPosition %}
              {% include 'framework/shortcodes/responsive-image'
                , src: post.data.thumbnail
                , alt: post.data.title
                , ImagePosition: galleryImgObjectPos
                , sizes: '(min-width: 1920px) 770px, (min-width: 1280px) 550px, (min-width: 1040px) 450px, (min-width: 780px) 330px, calc(50vw - 30px)'
              %}
            </a>
          </div>
          <figcaption class="gallery-caption">
            {% if post.data.year %}&copy;{{ post.data.year }} |
            {% endif %}
            {{ post.data.title }}</figcaption>
        </figure>
      {% endfor %}
    </div>
  </section>
</section>