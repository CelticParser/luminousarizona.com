{% comment %}
  JSON-LD Schema for LuminousArizona.com
  Author/Artist: Jason Robert O'Kennedy (also Jason Alan Kennedy)
  Per Google: https://developers.google.com/search/docs/appearance/structured-data/
{% endcomment %}
{% assign siteUrl = "https://luminousarizona.com" %}
{% assign licensePageUrl = siteUrl | append: "/photo-licensing/" %}
{% assign pageUrl = page.url | prepend: siteUrl %}
{% comment %} Phoenix, Arizona - MST (UTC-7), no DST {% endcomment %}
{% assign tzPhoenix = "T00:00:00-07:00" %}

{% comment %} BreadcrumbList - Build from URL path and page context {% endcomment %}
{% assign isHome = false %}
{% if page.url == "/" or page.url == "/index.html" %}
  {% assign isHome = true %}
{% endif %}
{% assign pathParts = page.url | replace: "/index.html", "" | split: "/" %}
{% assign segmentNames = "Home|Projects|About|Contact|Blog" | split: "|" %}
{% assign segmentPaths = "|projects|about|contact|blog" | split: "|" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ siteUrl }}/"
    }
    {% unless isHome %}
    {% assign pos = 2 %}
    {% assign breadcrumbPath = "" %}
    {% for part in pathParts %}
      {% if part != "" %}
        {% assign breadcrumbPath = breadcrumbPath | append: "/" | append: part %}
        {% assign segPath = breadcrumbPath | append: "/" %}
        {% assign itemName = part | replace: "-", " " | capitalize %}
        {% if segPath == "/projects/" %}
          {% assign itemName = "Projects" %}
        {% elsif segPath == "/about/" %}
          {% assign itemName = "About" %}
        {% elsif segPath == "/contact/" %}
          {% assign itemName = "Contact" %}
        {% elsif segPath == "/blog/" %}
          {% assign itemName = "Blog" %}
        {% elsif page.url contains "/projects/" %}
          {% if tags and title and segPath == page.url %}
            {% assign itemName = title %}
          {% elsif tags and forloop.index == 3 %}
            {% assign projectTag = tags.first | default: tags %}
            {% assign projectSlug = projectTag | slugify %}
            {% for project in collections.projects %}
              {% assign projTitleSlug = project.data.title | slugify %}
              {% if project.url contains projectSlug or projTitleSlug == projectSlug %}
                {% assign itemName = project.data.title %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% elsif image == null and forloop.index == 3 %}
            {% assign itemName = title %}
          {% endif %}
        {% elsif page.url contains "/about/" and segPath == page.url %}
          {% assign itemName = title | default: itemName %}
        {% endif %}
    ,{
      "@type": "ListItem",
      "position": {{ pos }},
      "name": {{ itemName | json }},
      "item": "{{ siteUrl }}{{ segPath }}"
    }
        {% assign pos = pos | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% endunless %}
  ]
}
</script>

{% comment %} 1. Person - Author/Artist (all pages) {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "{{ siteUrl }}/#/schema/person/jason-robert-okennedy",
  "name": "Jason Robert O'Kennedy",
  "alternateName": "Jason Alan Kennedy",
  "url": "https://www.instagram.com/jason.robert.okennedy/"
}
</script>

{% comment %} 2. Page schema - WebSite + WebPage for homepage, Article for other pages {% endcomment %}
{% if page.url == "/" or page.url == "/index.html" %}
{% comment %} Homepage: WebSite + WebPage {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.title | json }},
  "url": "{{ siteUrl }}/",
  "author": { "@id": "{{ siteUrl }}/#/schema/person/jason-robert-okennedy" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ title | default: site.title | json }},
  "description": {{ description | default: meta_description | default: site.title | json }},
  "url": "{{ pageUrl }}",
  "author": { "@id": "{{ siteUrl }}/#/schema/person/jason-robert-okennedy" }
  {% if featured and featured.size > 0 %},
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "contentUrl": "{{ siteUrl }}/assets/images/{{ featured[0].image }}",
    "copyrightNotice": "Jason Robert O'Kennedy",
    "license": "{{ licensePageUrl }}",
    "acquireLicensePage": "{{ licensePageUrl }}"
  }
  {% endif %}
}
</script>
{% else %}
{% comment %} Other pages: Article {% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | default: site.title | json }},
  "description": {{ description | default: meta_description | default: site.title | json }},
  "url": "{{ pageUrl }}",
  "author": {
    "@id": "{{ siteUrl }}/#/schema/person/jason-robert-okennedy"
  },
  "datePublished": "{% if date %}{{ date | date: '%Y-%m-%d' }}{% else %}2025-01-01{% endif %}{{ tzPhoenix }}",
  "dateModified": "{% if date %}{{ date | date: '%Y-%m-%d' }}{% else %}2025-01-01{% endif %}{{ tzPhoenix }}"
  {% if image %},
  "image": "{{ siteUrl }}/assets/images/{{ image }}"
  {% elsif featured and featured.size > 0 %},
  "image": "{{ siteUrl }}/assets/images/{{ featured[0].image }}"
  {% elsif thumbnail %},
  "image": "{{ siteUrl }}/assets/images/{{ thumbnail }}"
  {% endif %}
}
</script>
{% endif %}

{% comment %} 3. Photograph - Single image pages (image-landscape, image-portrait) {% endcomment %}
{% if image %}
{% assign photoLat = null %}
{% assign photoLng = null %}
{% if gMap and gMap[0].tripod %}
  {% assign tripodParts = gMap[0].tripod | split: "," %}
  {% if tripodParts.size >= 2 %}
    {% assign latPart = tripodParts[0] | split: ":" %}
    {% assign lngPart = tripodParts[1] | split: ":" %}
    {% if latPart.size >= 2 and lngPart.size >= 2 %}
      {% assign photoLat = latPart[1] | strip %}
      {% assign photoLng = lngPart[1] | strip %}
    {% endif %}
  {% endif %}
{% elsif gMap and gMap[0].center %}
  {% assign centerParts = gMap[0].center | split: "," %}
  {% if centerParts.size >= 2 %}
    {% assign latPart = centerParts[0] | split: ":" %}
    {% assign lngPart = centerParts[1] | split: ":" %}
    {% if latPart.size >= 2 and lngPart.size >= 2 %}
      {% assign photoLat = latPart[1] | strip %}
      {% assign photoLng = lngPart[1] | strip %}
    {% endif %}
  {% endif %}
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Photograph",
  "name": {{ title | default: image | json }},
  "description": {{ alt | default: title | default: image | json }},
  "author": { "@id": "{{ siteUrl }}/#/schema/person/jason-robert-okennedy" },
  "dateCreated": "{% if year %}{{ year }}{% elsif date %}{{ date | date: '%Y' }}{% else %}2025{% endif %}-01-01{{ tzPhoenix }}",
  "contentUrl": "{{ siteUrl }}/assets/images/{{ image }}",
  "copyrightNotice": "Jason Robert O'Kennedy",
  "license": "{{ licensePageUrl }}",
  "acquireLicensePage": "{{ licensePageUrl }}",
  "isPartOf": {
    "@type": "CreativeWork",
    "name": {{ title | default: site.title | json }},
    "url": "{{ pageUrl }}"
  }
  {% if photoLat and photoLng %},
  "contentLocation": {
    "@type": "Place",
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ photoLat }},
      "longitude": {{ photoLng }}
    }
  }
  {% endif %}
}
</script>
{% endif %}

{% comment %} 4. Photograph(s) - Featured images on project/home pages {% endcomment %}
{% if featured and image == null %}
{% assign centerLat = null %}
{% assign centerLng = null %}
{% if gMap and gMap[0].center %}
  {% assign centerParts = gMap[0].center | split: "," %}
  {% if centerParts.size >= 2 %}
    {% assign latPart = centerParts[0] | split: ":" %}
    {% assign lngPart = centerParts[1] | split: ":" %}
    {% if latPart.size >= 2 and lngPart.size >= 2 %}
      {% assign centerLat = latPart[1] | strip %}
      {% assign centerLng = lngPart[1] | strip %}
    {% endif %}
  {% endif %}
{% endif %}
{% for item in featured limit: 10 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Photograph",
  "name": {{ item.caption | default: item.image | json }},
  "description": {{ item.alt | default: item.caption | default: item.image | json }},
  "author": { "@id": "{{ siteUrl }}/#/schema/person/jason-robert-okennedy" },
  "dateCreated": "{{ item.year | default: '2025' }}-01-01{{ tzPhoenix }}",
  "contentUrl": "{{ siteUrl }}/assets/images/{{ item.image }}",
  "copyrightNotice": "Jason Robert O'Kennedy",
  "license": "{{ licensePageUrl }}",
  "acquireLicensePage": "{{ licensePageUrl }}",
  "isPartOf": {
    "@type": "CreativeWork",
    "name": {{ title | default: site.title | json }},
    "url": "{{ pageUrl }}"
  }
  {% if centerLat and centerLng %},
  "contentLocation": {
    "@type": "Place",
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ centerLat }},
      "longitude": {{ centerLng }}
    }
  }
  {% endif %}
}
</script>
{% endfor %}
{% endif %}
