---
layout: default
body_classes: page-project
---

{% assign limit = gallery_limit | default: 100 %}

<main class="section">
  <div class="container">
    <section class="row">
      {% comment %} Split content at <!-- Break to wrap image --> comment {% endcomment %}
      {% assign contentParts = content | split: '<!-- Break to wrap image -->' %}
      {% assign contentBeforeBreak = contentParts[0] %}
      {% assign contentAfterBreak = contentParts[1] %}

      {% if featured %}
        <aside class="col-12 col-md-6 mb-6 mb-md-0">
          {% include 'framework/project-breadcrumb' %}
          <div class="gallery gallery-single-column">
            {% for item in featured limit: limit %}
              <figure>
                <a href="/projects/{{ title | slugify }}/{% if item.slug %}{{ item.slug }}{% else %}{{ item.caption | slugify }}{% endif %}/">
                  <div class="gallery-image">
                    {% include 'framework/shortcodes/responsive-image'
                      , src: item.image
                      , alt: item.caption
                      , style: 'vertical-align: bottom; max-width: 100%; height: auto;'
                      , sizes: '(min-width: 1920px) 770px, (min-width: 1280px) 550px, (min-width: 1040px) 450px, (min-width: 780px) 330px, calc(50vw - 30px)'
                    %}
                  </div>
                </a>
                <figcaption class="gallery-caption">
                  &copy;{{ item.year }} | {{ item.caption }}
                </figcaption>
              </figure>
            {% endfor %}
          </div>
        </aside>
      {% endif %}

      <article class="col-12 col-md-6">
        {% if title %}
          <header class="project-heading">
            <h1>{{ title }}</h1>
            {% if subTitle %}
              <p style="font-size: 1.2em">{{ subTitle }}</p>
            {% endif %}
          </header>
        {% endif %}

        <div class="content">
          {% if contentBeforeBreak %}
            {{ contentBeforeBreak }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
      </article>
    </section>
    {% if contentAfterBreak %}
      <hr>
      <section class="row">
        <div class="col-12">
          <div class="content content-below-image">
            {{ contentAfterBreak }}
          </div>
        </div>
      </section>
    {% endif %}
    <hr>
    {% include 'framework/project-navigation' %}
    {% include 'project-gallery' %}

    {% if title %}
      <section>
        <h2>Tripod Locations for {{ title }}</h2>
        {% include 'theme/tripod-map'
          , heading: projects.heading sub_heading: projects.sub_heading
        %}
      </section>
    {% endif %}
  </div>
</main>