---
layout: default
body_classes: page-project
---

<main class="section">
  <div class="container">
    <section class="row">
      {% comment %} Multi-project pages: variantContentHtml; else full markdown body {% endcomment %}
      {% if variantContentHtml != '' %}
        {% assign contentParts = variantContentHtml | split: '<!-- section break -->' %}
      {% else %}
        {% assign contentParts = content | split: '<!-- section break -->' %}
      {% endif %}
      {% assign contentBeforeBreak = contentParts[0] %}
      {% assign contentAfterBreak = contentParts[1] %}

      <aside class="col-12 col-md-6 mb-6 mb-md-0">
        {% include 'framework/project-breadcrumb' %}
        <div class="gallery gallery-single-column">
          <figure>
            <a href="/assets/images/{{ image }}">
              <div class="gallery-image">
                {% include 'framework/shortcodes/responsive-image'
                  , src: image
                  , alt: title
                  , style: 'vertical-align: bottom; max-width: 100%; height: auto;'
                  , ImagePosition: ImagePosition
                  , sizes: '(min-width: 1920px) 770px, (min-width: 1280px) 550px, (min-width: 1040px) 450px, (min-width: 780px) 330px, calc(50vw - 30px)'
                %}
              </div>
            </a>
            <figcaption class="gallery-caption">
              &copy;{{ year }} | {{ title }}
            </figcaption>
          </figure>
        </div>
      </aside>

      <article class="col-12 col-md-6">
        {% if title %}
          <header class="project-heading">
            <h1>{{ title }}</h1>
            {% if subTitle %}
              <!-- TODO Link subTitle to Tripod Section -->
              <p style="font-size: 1.2em">{{ subTitle }}</p>
            {% endif %}
          </header>
        {% endif %}

        <div class="content">
          {% if contentBeforeBreak %}
            {{ contentBeforeBreak }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
        {% include 'framework/image-navigation' %}
      </article>
    </section>
    {% if contentAfterBreak %}
      <hr>
      <section class="row">
        <div class="col-12">
          <div class="content content-below-image">
            {{ contentAfterBreak }}
          </div>
        </div>
      </section>
    {% endif %}
    <hr>
    <section class="mt-6">
      <h2>Tripod Location for {{ title }}</h2>
      {% include 'theme/tripod-location' %}
      {% include 'theme/tripod-map' %}
    </section>
  </div>
</main>