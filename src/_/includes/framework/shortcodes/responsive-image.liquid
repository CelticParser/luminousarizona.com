{% comment %}
  Responsive Image Include
  Usage:
  {% include 'framework/shortcodes/responsive-image',
    src: 'image-name.jpg',
    alt: 'Image description',
    style: 'max-width: 100%; height: auto;',
    class: 'gallery-image',
    ImagePosition: '50% 30%',
    sizes: '(min-width: 1360px) 1220px, calc(94.23vw - 43px)'
  %}
  Parameters:
  - src: Image filename (required) - should be in /assets/images/
  - alt: Alt text for accessibility (default: '')
  - style: Inline CSS styles (optional)
  - class: CSS class(es) (optional)
  - ImagePosition: value for CSS object-position (optional), e.g. "center top" or "100% 80%"
  - sizes: Sizes attribute for responsive images (optional)
{% endcomment %}

{% if src %}
  {% assign imageSrc = src %}
  {% assign imageAlt = alt | default: '' %}
  {% assign imgObjectPosition = ImagePosition | default: '' | strip | replace: ';', '' %}

  {% comment %} Build style attribute, combining style and ImagePosition if provided {% endcomment %}
  {% assign combinedStyle = style | default: '' %}
  {% if imgObjectPosition != '' %}
    {% if combinedStyle != '' %}
      {% assign combinedStyle = combinedStyle | append: ' object-position: ' | append: imgObjectPosition | append: ';' %}
    {% else %}
      {% assign combinedStyle = 'object-position: ' | append: imgObjectPosition | append: ';' %}
    {% endif %}
  {% endif %}

  {% comment %} Use the responsiveImage shortcode (single line required for Liquid parser) {% endcomment %}
  {% responsiveImage imageSrc, imageAlt, combinedStyle, class, sizes %}
{% else %}
  {% comment %} Fallback if no src provided {% endcomment %}
  <img src="{{ src }}" alt="{{ alt | default: '' }}">
{% endif %}
