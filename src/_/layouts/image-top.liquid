---
layout: default
body_classes: page-project
---

<div class="section">
  <div class="container">
    <div class="row mb-6">
      <div class="col">
        {% include 'framework/project-breadcrumb' %}
        <div class="gallery">
          <div class="gallery-item">
            <a href="/assets/images/{{ image }}">
              <div class="gallery-image">
                {% include 'framework/shortcodes/responsive-image',
                  src: image,
                  alt: title
                %}
              </div>
            </a>
            <div class="gallery-caption" style="float:right">
              &copy;{{ year }} | {{ title }}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="project-heading">
      <h1>{{ title }}</h1>
    </div>

    <div class="content" style="width: 100%">{{ content }}</div>

    <div>
      <h2>Tripod Location for {{ title }}</h2>
      {% include 'theme/tripod-map' %}
    </div>
  </div>
</div>