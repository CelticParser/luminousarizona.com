{% comment %} Image navigation: previous/next images within the same project {% endcomment %}
{% if tags %}
  {% comment %} Get all images with the same project tag(s), sorted by title {% endcomment %}
  {% comment %} Extract project tag from URL path (e.g., /projects/tribal-lands/...) or use first tag {% endcomment %}
  {% assign urlParts = page.url | split: '/' %}
  {% if urlParts.size >= 3 %}
    {% assign projectTag = urlParts[2] %}
    {% else %}
    {% comment %} Fallback: use first tag from tags array or tags string {% endcomment %}
    {% if tags.first %}
      {% assign projectTag = tags.first %}
    {% else %}
      {% assign projectTag = tags %}
    {% endif %}
  {% endif %}

  {% comment %} Get images that have this project tag (supports both string and array) {% endcomment %}
  {% assign projectImages = "" | split: "," %}
  {% for image in collections.images %}
    {% assign imageTags = image.data.tags %}
    {% assign hasTag = false %}
    {% if imageTags %}
      {% if imageTags == projectTag %}
        {% assign hasTag = true %}
        {% elsif imageTags.first %}
        {% comment %} tags is an array {% endcomment %}
        {% for tag in imageTags %}
          {% if tag == projectTag %}
            {% assign hasTag = true %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endif %}
    {% if hasTag %}
      {% assign projectImages = projectImages | push: image %}
    {% endif %}
  {% endfor %}
  {% assign projectImages = projectImages | sort: "data.title" %}

  {% comment %} Find current image index by comparing URLs {% endcomment %}
  {% assign currentIndex = -1 %}
  {% for image in projectImages %}
    {% if image.url == page.url or image.url == url %}
      {% assign currentIndex = forloop.index0 %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if currentIndex >= 0 %}
    {% assign prevIndex = currentIndex | minus: 1 %}
    {% assign nextIndex = currentIndex | plus: 1 %}

    <nav class="image-navigation" aria-label="Image navigation">
      {% if prevIndex >= 0 %}
        {% assign prevImage = projectImages[prevIndex] %}
        <a
          href="{{ prevImage.url }}"
          class="nav-link nav-prev"
          aria-label="Previous image">
          <span class="nav-arrow">←</span>
          {{ prevImage.data.title }}
        </a>
      {% endif %}

      {% if prevIndex >= 0 and nextIndex < projectImages.size %}
        <span class="nav-separator">|</span>
      {% endif %}

      {% if nextIndex < projectImages.size %}
        {% assign nextImage = projectImages[nextIndex] %}
        <a
          href="{{ nextImage.url }}"
          class="nav-link nav-next"
          aria-label="Next image">
          {{ nextImage.data.title }}
          <span class="nav-arrow">→</span>
        </a>
      {% endif %}
      <hr>
    </nav>

  {% endif %}
{% endif %}