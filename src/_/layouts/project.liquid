---
layout: default
body_classes: page-project
---

{% assign limit = gallery_limit | default: 6 %}

<main class="section">
  <div class="container">
    <section class="row">
      <aside class="col-12 col-md-6 mb-4">
        {% if title %}
          <header class="project-heading">
            <h1>{{ title }}</h1>
          </header>
        {% endif %}

        {% if categories %}
          <div class="project-categories">
            {% include 'framework/categories-badges'
              , categories: categories
            %}
          </div>
        {% endif %}

        {% if date %}
          <div class="project-date">
            <strong>Date
            </strong>
            <span>{{ date | date_to_long_string }}</span>
          </div>
        {% endif %}

      <article class="col-12 col-md-6 mb-4">
        <div class="content">{{ content }}</div>
        {% include 'framework/project-navigation' %}
      </article>
    </section>

    <section class="row">
      <section class="col">
        <div class="gallery gallery-masonry">
          {% for item in gallery limit: limit %}
            <figure class="gallery-item">
              <div class="gallery-image">
                {% include 'framework/shortcodes/responsive-image'
                  , src: item.image
                  , alt: item.caption
                %}
              </div>
              {% if item.caption %}
                <figcaption class="gallery-caption">{{ item.caption }}</figcaption>
              {% endif %}
            </figure>
          {% endfor %}
        </div>
      </section>
    </section>
  </div>
</main>

<script src="https://unpkg.com/masonry-layout@4/dist/masonry.pkgd.min.js"></script>
<script src="https://unpkg.com/imagesloaded@5/imagesloaded.pkgd.min.js"></script>
<script>
  var grid = document.querySelector('.gallery');
  var msnry;

  imagesLoaded( grid, function() {
    msnry = new Masonry( grid, {
      itemSelector: '.gallery-item',
      percentPosition: true,
    });
  });
</script>