<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDEXBEzrYSrSMcd6g3yS-DpeD2fVuCpUfc&callback=initMap&loading=async&libraries=marker"></script>

<div id="map" style="aspect-ratio: 16 / 9; width: 100%;"></div>

<script>
    function initMap() {
        {% comment %} Get center and zoom - from project's gMap if isProject, or from image's gMap if image page {% endcomment %}
        {% assign mapCenterLat = '34.5667' %}
        {% assign mapCenterLng = '-111.85' %}
        {% assign mapZoom = '8' %}
        
        {% comment %} Parse gMap center/zoom configuration {% endcomment %}
        {% if gMap and gMap.size > 0 %}
          {% assign gMapConfig = gMap[0] %}
          
          {% comment %} Parse zoom first (before center parsing) {% endcomment %}
          {% if gMapConfig.zoom %}
            {% assign mapZoom = gMapConfig.zoom %}
          {% endif %}
          
          {% comment %} Parse center coordinates {% endcomment %}
          {% if gMapConfig.center %}
            {% assign centerStr = gMapConfig.center %}
            {% assign centerParts = centerStr | split: ',' %}
            {% if centerParts.size >= 2 %}
              {% assign latStr = centerParts[0] | split: ':' %}
              {% assign lngStr = centerParts[1] | split: ':' %}
              {% if latStr.size >= 2 and lngStr.size >= 2 %}
                {% assign mapCenterLat = latStr[1] | strip %}
                {% assign mapCenterLng = lngStr[1] | strip %}
              {% endif %}
            {% endif %}
          {% elsif gMapConfig.tripod and isProject == false %}
            {% comment %} Image page: If no center specified, use tripod location as center {% endcomment %}
            {% assign tripodStr = gMapConfig.tripod %}
            {% assign tripodParts = tripodStr | split: ',' %}
            {% if tripodParts.size >= 2 %}
              {% assign latPart = tripodParts[0] | split: ':' %}
              {% assign lngPart = tripodParts[1] | split: ':' %}
              {% if latPart.size >= 2 and lngPart.size >= 2 %}
                {% assign mapCenterLat = latPart[1] | strip %}
                {% assign mapCenterLng = lngPart[1] | strip %}
              {% endif %}
            {% endif %}
          {% endif %}
        {% endif %}
        
        // Detect mobile devices (typically < 768px width)
        const isMobile = window.innerWidth < 768;
        
        // Adjust zoom: reduce by 2 steps on mobile
        // Ensure zoom is a number (parseInt handles string values from frontmatter)
        let adjustedZoom = parseInt({{ mapZoom }}, 10);
        if (isNaN(adjustedZoom)) {
            adjustedZoom = 8; // Fallback to default
        }
        console.log('Map zoom from frontmatter:', {{ mapZoom }}, 'Parsed zoom:', adjustedZoom);
        if (isMobile && adjustedZoom > 1) {
            adjustedZoom = Math.max(1, adjustedZoom - 2);
            console.log('Mobile detected, adjusted zoom:', adjustedZoom);
        }
        
        const mapOptions = {
            center: { 
                lat: {{ mapCenterLat }},
                lng: {{ mapCenterLng }}
            },
            zoom: adjustedZoom,
            mapId: "1fd95539b9a6382ce645575f",
        };

        const map = new google.maps.Map(document.getElementById('map'), mapOptions);
        
        // Create a shared InfoWindow for marker titles
        const infoWindow = new google.maps.InfoWindow();

        {% if isProject %}
          {% comment %} Project page: show all pins from project images {% endcomment %}
          // Get project images from collections using project title as tag
          {% assign projectTag = title | slugify %}
          {% assign projectImages = collections[projectTag] %}
          
          // Define custom points from project images' gMap.tripod
          const customPoints = [
            {% if projectImages %}
              {% assign pointCount = 0 %}
              {% for image in projectImages %}
                {% if image.data.gMap and image.data.gMap.size > 0 %}
                  {% assign imageGMap = image.data.gMap[0] %}
                  {% if imageGMap.tripod %}
                    {% comment %} Parse tripod string: "lat: 36.970402, lng: -110.141348" {% endcomment %}
                    {% assign tripodStr = imageGMap.tripod %}
                    {% assign tripodParts = tripodStr | split: ',' %}
                    {% if tripodParts.size >= 2 %}
                      {% assign latPart = tripodParts[0] | split: ':' %}
                      {% assign lngPart = tripodParts[1] | split: ':' %}
                      {% if latPart.size >= 2 and lngPart.size >= 2 %}
                        {% assign parsedLat = latPart[1] | strip %}
                        {% assign parsedLng = lngPart[1] | strip %}
                        {% if pointCount > 0 %},{% endif %}
                        {
                            lat: {{ parsedLat }},
                            lng: {{ parsedLng }}, 
                            title: '{{ image.data.title | escape }}',
                            imageUrl: '{{ image.data.image }}',
                            pageUrl: '{{ image.url }}',
                            portrait: {% if imageGMap.portrait == true %}true{% else %}false{% endif %}
                        }
                        {% assign pointCount = pointCount | plus: 1 %}
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% endif %}
          ];
        {% else %}
          {% comment %} Image page: show single pin for this image {% endcomment %}
          {% assign hasValidTripod = false %}
          {% if gMap and gMap.size > 0 %}
            {% assign imageGMap = gMap[0] %}
            {% if imageGMap.tripod and imageGMap.tripod != "" and imageGMap.tripod != "NULL" %}
              {% assign tripodStr = imageGMap.tripod %}
              {% assign tripodParts = tripodStr | split: ',' %}
              {% if tripodParts.size >= 2 %}
                {% assign latPart = tripodParts[0] | split: ':' %}
                {% assign lngPart = tripodParts[1] | split: ':' %}
                {% if latPart.size >= 2 and lngPart.size >= 2 %}
                  {% assign parsedLat = latPart[1] | strip %}
                  {% assign parsedLng = lngPart[1] | strip %}
                  {% if parsedLat != "" and parsedLng != "" %}
                    {% assign hasValidTripod = true %}
                    const customPoints = [
                      {
                          lat: {{ parsedLat }},
                          lng: {{ parsedLng }}, 
                          title: '{{ title | escape }}',
                          imageUrl: '{{ image }}',
                          pageUrl: '{{ page.url }}',
                          portrait: {% if imageGMap.portrait == true %}true{% else %}false{% endif %}
                      }
                    ];
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endif %}
          {% unless hasValidTripod %}const customPoints = [];{% endunless %}
        {% endif %}

        // Function to create custom icon element with border and pointer for AdvancedMarkerElement
        function createCustomIconElement(imageUrl, isPortrait, isMobileDevice) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.crossOrigin = 'anonymous';
                
                img.onerror = function(error) {
                    console.error('Failed to load image for marker:', imageUrl, error);
                    reject(new Error('Failed to load image: ' + imageUrl));
                };
                
                img.onload = function() {
                    // Set dimensions based on orientation
                    // Reduce by half on mobile devices
                    let imgWidth = isPortrait ? 50 : 80;
                    let imgHeight = isPortrait ? 70 : 50;
                    let borderWidth = 2;
                    let pointerHeight = 10;
                    let pointerWidth = 12;
                    
                    if (isMobileDevice) {
                        imgWidth = Math.floor(imgWidth / 2);
                        imgHeight = Math.floor(imgHeight / 2);
                        borderWidth = Math.floor(borderWidth / 2) || 1;
                        pointerHeight = Math.floor(pointerHeight / 2) || 5;
                        pointerWidth = Math.floor(pointerWidth / 2) || 6;
                    }
                    
                    // Total canvas dimensions (image + border + pointer)
                    const canvasWidth = imgWidth + (borderWidth * 2);
                    const canvasHeight = imgHeight + (borderWidth * 2) + pointerHeight;
                    
                    const canvas = document.createElement('canvas');
                    canvas.width = canvasWidth;
                    canvas.height = canvasHeight;
                    const ctx = canvas.getContext('2d');
                    
                    // Draw orange border around image
                    ctx.fillStyle = '#FF8C00'; // Orange color
                    ctx.fillRect(0, 0, canvasWidth, imgHeight + (borderWidth * 2));
                    
                    // Apply object-fit: cover behavior
                    // Calculate aspect ratios
                    const sourceAspect = img.naturalWidth / img.naturalHeight;
                    const targetAspect = imgWidth / imgHeight;
                    
                    let drawWidth, drawHeight, sourceX, sourceY, sourceWidth, sourceHeight;
                    
                    if (sourceAspect > targetAspect) {
                        // Source is wider - fit to height and crop width
                        drawHeight = imgHeight;
                        drawWidth = imgHeight * sourceAspect;
                        sourceX = (img.naturalWidth - (img.naturalHeight * targetAspect)) / 2;
                        sourceY = 0;
                        sourceWidth = img.naturalHeight * targetAspect;
                        sourceHeight = img.naturalHeight;
                    } else {
                        // Source is taller - fit to width and crop height
                        drawWidth = imgWidth;
                        drawHeight = imgWidth / sourceAspect;
                        sourceX = 0;
                        sourceY = (img.naturalHeight - (img.naturalWidth / targetAspect)) / 2;
                        sourceWidth = img.naturalWidth;
                        sourceHeight = img.naturalWidth / targetAspect;
                    }
                    
                    // Draw image with cover behavior (cropped and centered)
                    ctx.drawImage(
                        img,
                        sourceX, sourceY, sourceWidth, sourceHeight, // Source rectangle
                        borderWidth, borderWidth, imgWidth, imgHeight // Destination rectangle
                    );
                    
                    // Draw orange pointer pin at bottom center
                    const pointerX = (canvasWidth / 2) - (pointerWidth / 2);
                    const pointerY = imgHeight + (borderWidth * 2);
                    
                    ctx.beginPath();
                    ctx.moveTo(pointerX, pointerY);
                    ctx.lineTo(pointerX + (pointerWidth / 2), pointerY + pointerHeight);
                    ctx.lineTo(pointerX + pointerWidth, pointerY);
                    ctx.closePath();
                    ctx.fillStyle = '#FF8C00'; // Orange color
                    ctx.fill();
                    
                    // Add orange border to pointer
                    ctx.strokeStyle = '#FF8C00';
                    ctx.lineWidth = 1;
                    ctx.stroke();
                    
                    // Create container element for AdvancedMarkerElement
                    const container = document.createElement('div');
                    container.style.width = canvasWidth + 'px';
                    container.style.height = canvasHeight + 'px';
                    container.style.position = 'relative';
                    // Anchor point at bottom center of pointer - use CSS transform to position
                    container.style.transform = `translate(-${canvasWidth / 2}px, -${canvasHeight}px)`;
                    container.style.transformOrigin = 'bottom center';
                    
                    // Create img element from canvas
                    const markerImg = document.createElement('img');
                    markerImg.src = canvas.toDataURL();
                    markerImg.style.width = '100%';
                    markerImg.style.height = '100%';
                    markerImg.style.display = 'block';
                    markerImg.style.objectFit = 'contain';
                    
                    container.appendChild(markerImg);
                    
                    resolve(container);
                };
                
                img.onerror = function() {
                    // Fallback if image fails to load - create simple container
                    const fallbackWidth = isPortrait ? 50 : 80;
                    const fallbackHeight = isPortrait ? 70 : 50;
                    
                    const container = document.createElement('div');
                    container.style.width = fallbackWidth + 'px';
                    container.style.height = fallbackHeight + 'px';
                    container.style.position = 'relative';
                    // Anchor point at bottom center
                    container.style.transform = `translate(-${fallbackWidth / 2}px, -${fallbackHeight}px)`;
                    container.style.transformOrigin = 'bottom center';
                    
                    const markerImg = document.createElement('img');
                    markerImg.src = imageUrl;
                    markerImg.style.width = '100%';
                    markerImg.style.height = '100%';
                    markerImg.style.display = 'block';
                    markerImg.style.objectFit = 'cover';
                    
                    container.appendChild(markerImg);
                    
                    resolve(container);
                };
                
                img.src = imageUrl;
            });
        }

        // Add markers for each custom point using AdvancedMarkerElement
        console.log('Creating markers for', customPoints.length, 'points');
        if (customPoints.length === 0) {
            console.warn('No custom points to display on map');
        }
        
        // If we have points, center map on first point
        if (customPoints.length > 0) {
            const firstPoint = customPoints[0];
            map.setCenter({ lat: firstPoint.lat, lng: firstPoint.lng });
            console.log('Map centered on', firstPoint.lat, firstPoint.lng);
        }
        
        customPoints.forEach((point) => {
            // Create absolute URL for the image
            const baseUrl = window.location.origin;
            const imageUrl = baseUrl + '/assets/images/' + point.imageUrl;
            console.log('Creating marker for', point.title, 'at', point.lat, point.lng, 'with image', imageUrl);
            
            // Create custom icon element with border and pointer
            createCustomIconElement(imageUrl, point.portrait, isMobile).then((iconElement) => {
                console.log('Icon created successfully for', point.title);
                try {
                    const marker = new google.maps.marker.AdvancedMarkerElement({
                        position: { lat: point.lat, lng: point.lng },
                        map: map,
                        title: point.title,
                        content: iconElement
                    });
                    console.log('Marker created successfully for', point.title);
                    
                    // Show title instantly on hover
                    marker.addListener('gmp-pointerenter', function() {
                        infoWindow.setContent(`<div style="padding: 8px; font-size: 14px;">${point.title}</div>`);
                        infoWindow.open(map, marker);
                    });
                    
                    // Hide title when pointer leaves
                    marker.addListener('gmp-pointerleave', function() {
                        infoWindow.close();
                    });
                    
                    // Add click event to navigate to image page
                    marker.addListener('gmp-click', function() {
                        // Close info window if open
                        infoWindow.close();
                        
                        // Navigate to image page
                        window.location.href = point.pageUrl;
                    });
                } catch (error) {
                    console.error('Error creating AdvancedMarkerElement for', point.title, ':', error);
                }
            }).catch((error) => {
                console.error('Error creating marker for', point.title, ':', error);
                // Create a simple marker as fallback
                const marker = new google.maps.marker.AdvancedMarkerElement({
                    position: { lat: point.lat, lng: point.lng },
                    map: map,
                    title: point.title
                });
                
                marker.addListener('gmp-pointerenter', function() {
                    infoWindow.setContent(`<div style="padding: 8px; font-size: 14px;">${point.title}</div>`);
                    infoWindow.open(map, marker);
                });
                
                marker.addListener('gmp-pointerleave', function() {
                    infoWindow.close();
                });
                
                marker.addListener('gmp-click', function() {
                    infoWindow.close();
                    window.location.href = point.pageUrl;
                });
            });
        });
    }
</script>