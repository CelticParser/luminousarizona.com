<div class="bottom">
  <div class="container relative">
    <div class="row align-items-center justify-content-between">
      <div class="col-auto">
       
        {% if site.bottom.enable_bottom_menu %}
          {% include 'framework/menu-bottom' %}
        {% endif %}
        {% if site.cookie_banner.enabled and site.cookie_banner.show_manage_cookies_at_bottom %}
          <a href="#" data-cc="c-settings">Cookies</a>
        {% endif %}
        {% if site.bottom.copyright_text and site.bottom.copyright_text != "" %}
          <div class="copyright">{{ site.bottom.copyright_text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>